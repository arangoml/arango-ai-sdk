# Copy this file to "env" next to AI_Suite_SDK_demo.ipynb and fill in the
# empty values. The notebook reads "env"; keep it out of git.

# SDK install from the private package index. Nothing to change here.
SDK_VERSION="0.0.post1.dev34+gb94c1b068"
PIP_EXTRA_INDEX_URL="https://europe-west3-python.pkg.dev/arango-ml/arango-ml-internal-pypi/simple/"
PIP_KEYRING_PROVIDER="import"
PIP_NO_INPUT="1"

# Platform. GATEWAY is the public URL of the deployment, no trailing slash.
# The database must already exist.
GATEWAY=""
ARANGO_USERNAME=""
ARANGO_PASSWORD=""
DB_NAME=""

# Short, lowercase, unique for each run: the SDK cannot delete a project yet,
# so a re-used name fails at step 2.
PROJECT_NAME=""

# Model providers, for example "openai", "gpt-4o" and "text-embedding-3-small".
# The keys are stored once as secret profiles and never printed. Leave
# EMBEDDING_API_KEY empty to reuse CHAT_API_KEY.
CHAT_API_KEY=""
EMBEDDING_API_KEY=""
CHAT_API_PROVIDER=""
EMBEDDING_API_PROVIDER=""
CHAT_MODEL=""
EMBEDDING_MODEL=""

# ArangoDB user AutoGraph impersonates to resume File Parser jobs. Must exist
# with read/write on DB_NAME. The install does not check it.
FPS_RECOVERY_USERNAME=""

# One sub-folder per category; the folder name is the category label.
CORPUS_DIR="./corpus"
