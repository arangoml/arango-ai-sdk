# Copy to "env" next to AI_Suite_SDK_demo.ipynb and fill in.
# The notebook reads this file with override=True. Do not commit "env".

# Public base URL of the ArangoDB deployment, no trailing slash.
GATEWAY=https://<your-stack>

# Use ARANGO_USERNAME / ARANGO_PASSWORD (Windows always defines USERNAME).
ARANGO_USERNAME=root
ARANGO_PASSWORD=changeme

# Database must already exist.
DB_NAME=_system

# Short, lowercase, unique for this run. Becomes the File Manager scope root.
PROJECT_NAME=sdk-demo

# Raw keys are stored once as secret profiles. The demo never prints them.
CHAT_API_KEY=sk-...
EMBEDDING_API_KEY=sk-...
CHAT_API_PROVIDER=openai
EMBEDDING_API_PROVIDER=openai
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ArangoDB user AutoGraph impersonates to resume File Parser jobs. Must exist
# with rw on DB_NAME. The install does not check; a missing user deploys green.
FPS_RECOVERY_USERNAME=root

# Local folder: one sub-folder per category. The folder name is the category
# label passed to corpus_build, strategize, orchestrate, and ingest.
CORPUS_DIR=./corpus
