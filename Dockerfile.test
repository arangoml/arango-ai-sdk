# Test image for the in-cluster integration run, run by the chart's helm-test
# pod. Not part of the published package.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
# Same uv as CI. Dependencies come from public PyPI only, so no private-index
# credentials are needed here.
RUN pip install --no-cache-dir uv==0.6.3

WORKDIR /app

# hatch-vcs derives the version from git, which is not in the image. Pretend a
# version; it never leaves this container.
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
COPY tests/ tests/
RUN uv sync --locked

# uid 1000 matches the chart's runAsUser/fsGroup for the helm-test pod. pytest
# needs a writable rootdir, and uv a writable HOME.
RUN useradd --uid 1000 --user-group --no-create-home --shell /usr/sbin/nologin app \
    && chown -R 1000:1000 /app
USER 1000:1000
ENV HOME=/tmp

# /debug is the volume the platform attaches to the test pod and the JUnit file
# the CI results orb collects.
CMD ["uv", "run", "--no-sync", "pytest", "-v", "tests/integration", "--junitxml=/debug/junit.xml"]
